# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
# Persistent filesystem path for post media (required on self-hosted production).
# Mount the same volume here in both the web and worker services.
# MEDIA_STORAGE_DIR=/data/media
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
# Configuration ID created under Facebook Login for Business. It controls the
# Page and Instagram permissions requested during the OAuth dialog.
FACEBOOK_LOGIN_CONFIG_ID=your-facebook-login-business-config-id
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Show "connect with an access token" in Settings. Leave unset (off) while
# Meta reviews the app: it bypasses the official Instagram login screen.
# INSTAGRAM_MANUAL_TOKEN_ENABLED=true

# Show the plans and pricing section on the public home page. Leave unset (off)
# while Meta reviews the app: the plans promise limits the app does not enforce.
# LANDING_PRICING_ENABLED=true

# AI assistant (campaign drafts, reply variations). It talks to any
# OpenAI-compatible endpoint. All four values are required; leave AI_FEATURES_ENABLED
# unset (off) while Meta reviews the app. The key stays on the server.
# AI_FEATURES_ENABLED=true
# AI_API_BASE_URL=https://your-router.example.com/v1
# AI_API_KEY=replace-with-your-api-key
# AI_MODEL=replace-with-a-model-or-combo-name
# AI_MONTHLY_LIMIT=200
