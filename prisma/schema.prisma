// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  zernioConnection  ZernioConnection?
  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  facebookPages     FacebookPage[]
  facebookOAuthConnections FacebookOAuthConnection[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  mediaAssets       MediaAsset[]
  scheduledPosts    ScheduledPost[]
  storySequences    StorySequence[]
  externalStories   ExternalStory[]
  aiGenerations     AiGeneration[]
  aiConnection      AiConnection?

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  instagramId       String   @unique
  username          String
  name              String?
  provider          InstagramProvider @default(META)
  zernioAccountId   String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  authProvider      InstagramAuthProvider @default(INSTAGRAM_LOGIN)
  // When Meta refused a trial Reel for this account (subcode 2207081). The
  // composer disables the option instead of letting the next one fail too.
  trialReelsUnsupportedAt DateTime?
  facebookPageId    String?
  publishingPermissionGranted Boolean @default(false)
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations Automation[]
  dmLogs      DmLog[]
  linkClicks  LinkClick[]
  followerSnapshots FollowerSnapshot[]
  mediaAssets MediaAsset[]
  scheduledPosts ScheduledPost[]
  storySequences StorySequence[]
  externalStories ExternalStory[]

  @@index([workspaceId])
}

/// A Facebook Page connected through Facebook Login. Its page token is kept
/// separately from Instagram so adding Facebook never changes an existing
/// Instagram Login connection or its automations.
model FacebookPage {
  id                String   @id @default(cuid())
  workspaceId       String
  facebookPageId    String   @unique
  name              String
  username          String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Uploaded media kept on persistent storage until the owner removes it. The
/// public URL is signed from the asset id at request time so Meta can fetch the
/// file without exposing the workspace's authenticated routes.
model MediaAsset {
  id                 String          @id @default(cuid())
  workspaceId        String
  instagramAccountId  String
  fileName           String
  contentType         String          @default("application/octet-stream")
  storageKey          String          @unique
  byteSize            Int
  uploadedBytes       Int             @default(0)
  status              MediaAssetStatus @default(UPLOADING)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  scheduledPosts  ScheduledPost[]
  scheduledPostItems ScheduledPostMediaItem[]
  storySlides StorySlide[]

  @@index([workspaceId, instagramAccountId, createdAt])
  @@index([status, createdAt])
}

/// Short-lived handoff between the Facebook OAuth callback and the Page
/// picker. Only the encrypted user token is retained, and it expires quickly.
model FacebookOAuthConnection {
  id          String   @id @default(cuid())
  workspaceId String
  accessToken String
  pages       Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([expiresAt])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name           String
  goal           String?
  postId         String?
  postUrl        String?
  pendingNextReel Boolean @default(false)
  matchAnyPost   Boolean @default(false)
  keywords       String[]
  matchAnyWord   Boolean @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger — a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled Boolean @default(false)
  dmMessage      String
  openingDmEnabled     Boolean @default(false)
  openingDmMessage     String?
  openingDmButtonLabel String?
  linkButtonLabel      String?
  requireFollow           Boolean @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled Boolean @default(false)
  followUpMessage String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes Int @default(0)
  publicReplyEnabled Boolean @default(false)
  publicReplyMessage String?
  publicReplyMessages String[] @default([])
  isActive       Boolean @default(true)
  wholeWordMatch Boolean @default(true)
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)
  // Set for a "reply with a keyword" rule created from a Stories sequence.
  // Such a campaign only fires on DMs that reply to one of that sequence's
  // published Stories, so a common word like SIM can't trigger elsewhere.
  storySequenceId String?
  // Instagram media id of one Story (usually posted outside Fisga). When set,
  // the campaign answers only DMs that reply to that Story.
  storyMediaId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]
  abTests          AbTest[]
  scheduledPost    ScheduledPost?
  storySequence    StorySequence?   @relation(fields: [storySequenceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
  @@index([storySequenceId])
  @@index([storyMediaId])
}

model ScheduledPost {
  id                 String                @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  mediaAssetId       String
  automationId       String?               @unique
  mediaType          ScheduledPostMediaType
  status             ScheduledPostStatus  @default(DRAFT)
  caption            String                @default("") @db.Text
  scheduledAt        DateTime?
  timeZone           String                @default("UTC")
  shareToFeed        Boolean               @default(true)
  trialGraduationStrategy TrialReelGraduationStrategy?
  containerId        String?
  instagramMediaId   String?
  permalink           String?
  publishedAt        DateTime?
  publishStartedAt   DateTime?
  attempts           Int                   @default(0)
  lastError          String?               @db.Text
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  automation       Automation?     @relation(fields: [automationId], references: [id], onDelete: SetNull)
  mediaItems       ScheduledPostMediaItem[]

  @@index([workspaceId, instagramAccountId, scheduledAt])
  @@index([instagramAccountId, status, scheduledAt])
  @@index([instagramAccountId, status, trialGraduationStrategy, publishedAt])
  @@index([mediaAssetId])
}

/// Ordered media included in a scheduled Instagram carousel. The first item is
/// also stored in ScheduledPost.mediaAssetId for compatibility with older code.
model ScheduledPostMediaItem {
  id              String  @id @default(cuid())
  scheduledPostId String
  mediaAssetId    String
  position        Int
  containerId     String?

  scheduledPost ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset    @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([scheduledPostId, position])
  @@unique([scheduledPostId, mediaAssetId])
  @@index([mediaAssetId])
}

/// An ordered set of individually published Instagram Stories.
model StorySequence {
  id                 String              @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  title              String              @default("Nova sequência")
  status             StorySequenceStatus @default(DRAFT)
  scheduledAt        DateTime?
  timeZone           String              @default("UTC")
  publishedAt        DateTime?
  attempts           Int                 @default(0)
  lastError          String?             @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  slides           StorySlide[]
  replyCampaigns   Automation[]

  @@index([workspaceId, instagramAccountId, scheduledAt])
  @@index([instagramAccountId, status, scheduledAt])
}

/// One Story frame. Each slide is published as a separate Instagram media item.
model StorySlide {
  id               String          @id @default(cuid())
  sequenceId       String
  mediaAssetId     String
  position         Int
  status           StorySlideStatus @default(PENDING)
  containerId      String?
  instagramMediaId String?         @unique
  publishStartedAt DateTime?
  publishedAt      DateTime?
  lastError        String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  sequence   StorySequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset             @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  metrics    StoryMetricSnapshot[]

  @@unique([sequenceId, position])
  @@unique([sequenceId, mediaAssetId])
  @@index([mediaAssetId])
  @@index([sequenceId, status])
  @@index([publishedAt])
}

/// Periodic snapshots preserve insights after Instagram stops returning them.
model StoryMetricSnapshot {
  id                String   @id @default(cuid())
  storySlideId      String
  capturedAt        DateTime @default(now())
  reach             Int?
  views             Int?
  replies           Int?
  shares            Int?
  follows           Int?
  profileVisits     Int?
  totalInteractions Int?
  navigation        Json?

  storySlide StorySlide @relation(fields: [storySlideId], references: [id], onDelete: Cascade)

  @@index([storySlideId, capturedAt])
}

/// A Story posted outside Fisga (straight from the Instagram app), seen while
/// it was still live. Instagram stops returning a Story after 24 hours, so this
/// keeps what the capture job could read while it was available.
model ExternalStory {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  instagramMediaId   String   @unique
  mediaType          String?
  caption            String?  @db.Text
  permalink          String?
  mediaUrl           String?  @db.Text
  // Local copy of the Story media, kept for a few days after capture (see
  // EXTERNAL_STORY_MEDIA_RETENTION_DAYS) because Instagram stops serving it.
  mediaStorageKey    String?
  mediaContentType   String?
  mediaByteSize      Int?
  mediaStoredAt      DateTime?
  mediaPurgedAt      DateTime?
  postedAt           DateTime
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())

  workspace        Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount              @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  metrics          ExternalStoryMetricSnapshot[]

  @@index([workspaceId, postedAt])
  @@index([instagramAccountId, postedAt])
}

model ExternalStoryMetricSnapshot {
  id                String   @id @default(cuid())
  externalStoryId   String
  capturedAt        DateTime @default(now())
  reach             Int?
  views             Int?
  replies           Int?
  shares            Int?
  follows           Int?
  profileVisits     Int?
  totalInteractions Int?
  navigation        Json?

  externalStory ExternalStory @relation(fields: [externalStoryId], references: [id], onDelete: Cascade)

  @@index([externalStoryId, capturedAt])
}

/// One AI assistant request, kept only to enforce the monthly limit and to see
/// usage. The text of the request and of the answer is never stored.
model AiGeneration {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String
  kind         String
  model        String
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

/// A workspace's own AI endpoint (any OpenAI-compatible API), set from Settings.
/// The key is encrypted at rest and never sent back to the browser. A workspace
/// without a row falls back to the AI_* environment variables.
model AiConnection {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  baseUrl         String
  apiKeyEncrypted String   @db.Text
  model           String
  // Comma-separated model names to try, in order, when the main model fails.
  fallbackModels  String?
  enabled         Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum AbTestStatus {
  RUNNING
  ENDED
}

/// An A/B test of the link DM of one campaign. Variant A is the campaign as it
/// was when the test started, variant B is the change being tried. Each
/// variant has its own tracked link so its clicks are counted on their own.
/// While a test is RUNNING the worker sends each person one variant, picked
/// by a stable hash of the test and the person.
model AbTest {
  id           String       @id @default(cuid())
  automationId String
  status       AbTestStatus @default(RUNNING)
  /// Percent of people who get variant A. Variant B gets the rest.
  weightA      Int          @default(50)
  /// "A" or "B" when a winner was picked, null when it ended without one.
  winnerKey    String?
  startedAt    DateTime     @default(now())
  endedAt      DateTime?

  aDmMessage       String  @db.Text
  aLinkButtonLabel String?
  /// The address as typed, without the UTM parameters the tracked link adds.
  aDestinationUrl  String?
  aTrackedLinkId   String? @unique

  bDmMessage       String  @db.Text
  bLinkButtonLabel String?
  bDestinationUrl  String?
  bTrackedLinkId   String? @unique

  automation   Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  aTrackedLink TrackedLink? @relation("AbTestVariantA", fields: [aTrackedLinkId], references: [id], onDelete: SetNull)
  bTrackedLink TrackedLink? @relation("AbTestVariantB", fields: [bTrackedLinkId], references: [id], onDelete: SetNull)
  dmLogs       DmLog[]

  @@index([automationId, status])
}

model DmLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId   String
  commenterName String?
  commentText   String
  commentId     String
  matchedKeyword String?
  status        DmStatus @default(PENDING)
  attempts      Int      @default(0)
  dmSentAt      DateTime?
  errorMessage  String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  dmDeliveryUnconfirmed Boolean @default(false)
  publicReplyDeliveryUnconfirmed Boolean @default(false)
  publicReplySentAt DateTime?
  publicReplyError  String?
  // Instagram media id of the Story this DM replied to, when it was one.
  storyMediaId      String?
  // The A/B test this person was part of and the variant they were sent.
  abTestId          String?
  abVariantKey      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  abTest           AbTest?          @relation(fields: [abTestId], references: [id], onDelete: SetNull)

  @@index([abTestId, abVariantKey])
  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
  @@index([storyMediaId])
}

// Legacy reconciliation model; currently unwired. Runtime code does not read
// or write ProcessedComment. Current reconciliation dedup uses owner-reply
// checks and DmLog guards instead.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  // Which DM button this link is, starting at 0. Read links with
  // TRACKED_LINK_ORDER (lib/tracking/link-order.ts), never by createdAt alone:
  // links saved in one request share a createdAt, and Postgres returns tied
  // rows in no fixed order.
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]
  // Set when this link belongs to an A/B test variant. Such links are not
  // buttons of the campaign itself: read the campaign's own links with
  // NOT_AB_VARIANT_LINK (lib/ab/link-filter.ts).
  abTestAsA  AbTest?     @relation("AbTestVariantA")
  abTestAsB  AbTest?     @relation("AbTestVariantB")

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  // Token from the link's `?r=` (hashRecipientId), set on links sent in a DM.
  // Clicks are counted once per recipient, falling back to ipHash without it.
  recipientHash      String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  workspaceId String?
  object      String?
  payload     Json
  status      WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum InstagramAuthProvider {
  INSTAGRAM_LOGIN
  FACEBOOK_LOGIN
}

enum MediaAssetStatus {
  UPLOADING
  READY
}

enum ScheduledPostMediaType {
  IMAGE
  REEL
  CAROUSEL
}

enum TrialReelGraduationStrategy {
  MANUAL
  SS_PERFORMANCE
}

enum ScheduledPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

enum StorySequenceStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIAL
  FAILED
  CANCELED
}

enum StorySlideStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}


enum InstagramProvider {
  META
  ZERNIO
}

model ZernioConnection {
  workspaceId    String @id
  apiKey         String
  profileId      String?
  webhookId      String?
  webhookSecret  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Claims persist independently of BullMQ retention so old taps never resend.
model PostbackDelivery {
  id String @id
  createdAt DateTime @default(now())
}
